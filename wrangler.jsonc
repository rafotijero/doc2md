{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doc2md",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "doc2md.rafotijero.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Contadores de los cupos diarios. Crea el namespace con
  // `npx wrangler kv namespace create LIMITS` y pega aquí su id.
  "kv_namespaces": [
    { "binding": "LIMITS", "id": "REEMPLAZAR_CON_ID_DE_KV" }
  ],
  "vars": {
    // URL del servicio de Cloud Run (https://doc2md-xxxxxxxxxx.<región>.run.app)
    "BACKEND_URL": "REEMPLAZAR_CON_URL_DE_CLOUD_RUN",
    // Site key pública de Turnstile (la secret key va como secreto).
    "TURNSTILE_SITE_KEY": "REEMPLAZAR_CON_SITE_KEY",
    // Límites de la demo pública. Deben coincidir con MAX_FILE_MB y
    // MAX_OCR_PAGES del backend, que también los aplica.
    "MAX_FILE_MB": "10",
    "MAX_OCR_PAGES": "3",
    // Cupos diarios del público (el propietario no tiene). Con estos valores
    // el uso de Cloud Run queda por debajo de su capa gratuita mensual.
    "DAILY_LIMIT": "30",
    "DAILY_OCR_LIMIT": "10"
  }
  // Secretos (npx wrangler secret put <NOMBRE>): API_KEY, TURNSTILE_SECRET, OWNER_KEY
}
